# MCP deployment inputs. Initialize-Environment.ps1 creates a private .env.
# Do not deploy this example as-is: a missing/placeholder key is an error.

# Advertised SearXNG URL, not the SSH destination or the bridge's connection URL.
# Pi: raspberrypi (bridge default: http://192.168.1.2:8080).
# Local / Docker Desktop-integrated WSL: localhost for workstation browsers;
# the Docker bridge normally uses http://host.docker.internal:8080 instead.
# WSL-native Docker: choose an address actually reachable from the workstation
# and bridge container; localhost forwarding is not a cross-container guarantee.
SEARXNG_HOSTNAME=raspberrypi

# Published HOST port only. The container and healthcheck always use port 8080.
SEARXNG_PORT=8080

# Generated once into ignored .env; never copy a real value into tracked files.
# Exactly 64 random hexadecimal characters; rotation must be explicit.
SEARXNG_SECRET=
